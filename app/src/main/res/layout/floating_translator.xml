<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="6dp"
    android:background="#33000000"
    android:focusable="true"
    android:clickable="true">
    
    <!-- Header: Drag area + Tombol kecil -->
    <LinearLayout
        android:id="@+id/dragHandle"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="#22000000"
        android:padding="4dp">
        
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="🌐"
            android:textSize="16sp"
            android:gravity="center_vertical"/>
        
        <Button
            android:id="@+id/btnSwap"
            android:layout_width="30dp"
            android:layout_height="25dp"
            android:text="⇄"
            android:textSize="12sp"
            android:background="@drawable/bg_btn_small"
            android:textColor="#FFF"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"/>
        
        <Button
            android:id="@+id/btnClose"
            android:layout_width="30dp"
            android:layout_height="25dp"
            android:text="✕"
            android:textSize="12sp"
            android:background="@drawable/bg_btn_close"
            android:padding="0dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:layout_marginStart="4dp"/>
    </LinearLayout>
    
    <!-- Input minimal -->
    <EditText
        android:id="@+id/etInput"
        android:layout_width="match_parent"
        android:layout_height="35dp"
        android:hint="Ketik..."
        android:textColor="#FFF"
        android:textColorHint="#AAA"
        android:background="@drawable/bg_input_trans"
        android:padding="8dp"
        android:textSize="12sp"
        android:layout_marginTop="4dp"
        android:inputType="text"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:cursorVisible="true"/>
    
    <!-- Tombol terjemahkan minimal -->
    <Button
        android:id="@+id/btnTranslate"
        android:layout_width="match_parent"
        android:layout_height="30dp"
        android:text="Terjemahkan"
        android:textSize="11sp"
        android:textColor="#FFF"
        android:background="@drawable/bg_btn_translate"
        android:layout_marginTop="4dp"
        android:padding="0dp"/>
    
    <!-- Hasil - auto hide jika kosong -->
    <TextView
        android:id="@+id/tvOutput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#FFF"
        android:textSize="11sp"
        android:background="@drawable/bg_output_trans"
        android:padding="6dp"
        android:layout_marginTop="4dp"
        android:minHeight="25dp"
        android:visibility="gone"/>
    
    <!-- Rekomendasi kata -->
    <TextView
        android:id="@+id/tvRecommendation"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text=""
        android:textColor="#4CAF50"
        android:textSize="10sp"
        android:padding="4dp"
        android:visibility="gone"/>
    
    <!-- Credit -->
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="By Yad"
        android:textColor="#888"
        android:textSize="8sp"
        android:gravity="center"
        android:layout_marginTop="2dp"/>
    
</LinearLayout>